# ---- TOGGLES ------------------------------------------------------------
DATA_STORE=memory            # memory | firestore
AI_PROVIDER=mock             # mock   | gemini
SPEECH_PROVIDER=mock         # mock   | google_stt | gemini
CRY_MODEL=mock               # mock   | yamnet  (needs requirements-ml.txt)
AUTH_MODE=mock               # mock   | firebase

# ---- GOOGLE -------------------------------------------------------------
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=global # Gemini on Vertex AI location
GEMINI_USE_VERTEX=false      # true = Vertex AI (service account); false = API key
GEMINI_API_KEY=              # only when GEMINI_USE_VERTEX=false
GEMINI_MODEL=gemini-3.5-flash  # verify the current model id before deploying
STT_LANGUAGE=en-IN           # e.g. hi-IN, ta-IN

# ---- APP ----------------------------------------------------------------
CORS_ORIGINS=http://localhost:5173
DEFAULT_TIMEZONE=Asia/Kolkata
