# ---- DATA SOURCE --------------------------------------------------------
# mock = everything runs in the browser with synthetic data (no backend)
# live = calls the Baby API and Mother API (which can themselves run mocks)
VITE_API_MODE=mock
VITE_BABY_API_URL=http://localhost:8081
VITE_MOTHER_API_URL=http://localhost:8082

# ---- SIGN-IN -------------------------------------------------------------
# demo     = pick Meera (mother) or Arjun (partner); sends mock-<uid> tokens
# firebase = Google sign-in with Firebase Authentication
VITE_AUTH_MODE=demo
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
